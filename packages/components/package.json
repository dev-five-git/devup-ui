{
  "name": "@devup-ui/components",
  "description": "Zero Config, Zero FOUC, Zero Runtime, CSS in JS Preprocessor",
  "repository": "https://github.com/dev-five-git/devup-ui",
  "author": "devfive",
  "license": "Apache-2.0",
  "homepage": "https://devup-ui.com",
  "bugs": {
    "url": "https://github.com/dev-five-git/devup-ui/issues",
    "email": "contact@devfive.kr"
  },
  "keywords": [
    "css",
    "css-in-js",
    "css-in-js-preprocessor",
    "css-in-js-framework",
    "react"
  ],
  "version": "0.1.58",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "build": "bun ../../node_modules/@typescript/native/bin/tsc && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "package": "bun pm pack --pack-destination \"../../dist\""
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@devup-ui/react": "workspace:^",
    "react": "^19.3.0",
    "clsx": "^2.1"
  },
  "devDependencies": {
    "@devup-ui/vite-plugin": "workspace:^",
    "@storybook/addon-docs": "^10.6",
    "@storybook/addon-onboarding": "^10.6",
    "@storybook/react-vite": "^10.6",
    "@types/react": "^19.3",
    "eslint-plugin-storybook": "^10.6",
    "rollup-plugin-preserve-directives": "^0.4",
    "storybook": "^10.6",
    "typescript": "^7.0.2",
    "@typescript/typescript6": "^6.0",
    "vite": "^8.3",
    "vite-plugin-dts": "^5.1"
  },
  "peerDependencies": {
    "@devup-ui/react": "workspace:^",
    "react": "*"
  }
}
