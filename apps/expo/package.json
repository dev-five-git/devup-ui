{
  "name": "expo-example",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "export": "expo export --platform ios --platform android --platform web --no-bytecode --source-maps",
    "check": "node check-bundle.mjs",
    "check:web": "node check-web.mjs",
    "typecheck": "bun ../../node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@devup-ui/react": "workspace:^",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@devup-ui/metro-plugin": "workspace:^",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
