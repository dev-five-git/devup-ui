"import \"@devup-ui/react/devup-ui.css\";\nimport { forwardRef as __devupForwardRef } from \"react\";\nconst __devupStyled = (c) => (c.styledComponentId = \"devup\", c);\nimport { Base } from \"./base\";\nimport Top, { Mid, Renamed } from \"./mid\";\nexport const P = __devupStyled(__devupForwardRef(({ style, className, as: DevupAs = \"div\", forwardedAs, ...rest }, __devupRef) => <DevupAs {...Object.fromEntries(Object.entries(rest).filter(([k]) => k[0] !== \"$\" && k !== \"theme\"))} ref={__devupRef} as={forwardedAs} className={className ? `c--a j k l m ${className}` : \"c--a j k l m\"} style={style} />));\n\n{\n    \"Static(ExtractStaticStyle { property: \\\"color\\\", value: \\\"red\\\", level: 0, selector: Some(Selector(\\\"& .b--a\\\")), style_order: None, layer: None })\",\n    \"Static(ExtractStaticStyle { property: \\\"left\\\", value: \\\"0\\\", level: 0, selector: Some(Selector(\\\"& .b--a\\\")), style_order: None, layer: None })\",\n    \"Static(ExtractStaticStyle { property: \\\"margin\\\", value: \\\"0\\\", level: 0, selector: Some(Selector(\\\"& .a--a\\\")), style_order: None, layer: None })\",\n    \"Static(ExtractStaticStyle { property: \\\"top\\\", value: \\\"0\\\", level: 0, selector: Some(Selector(\\\"& .b--b\\\")), style_order: None, layer: None })\",\n}\n[\"/src/base.ts\", \"/src/mid.ts\"]"
