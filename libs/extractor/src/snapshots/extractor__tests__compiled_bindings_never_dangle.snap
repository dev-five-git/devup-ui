        "import { forwardRef as __devupForwardRef } from \"react\";\nexport const a = \"a-a\";\nexport const s = __devupForwardRef((__devupRefProps, __devupRef) => {\n\tconst { style, className, as: DevupAs = \"div\", forwardedAs, ...rest } = {\n\t\t...__devupRefProps,\n\t\tref: __devupRef\n\t};\n\treturn <DevupAs {...Object.fromEntries(Object.entries(rest).filter(([k]) => k[0] !== \"$\" && k !== \"theme\"))} as={forwardedAs} className={[\"a--c a-b\", className].filter(Boolean).join(\" \")} style={style} />;\n});\nexport const b = <div className=\"a-c\" />;",
