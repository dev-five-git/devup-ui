                        "test.tsx",
                    ),
                ),
                style_order: Some(
                    0,
                ),
                layer: Some(
                    "base.reset",
                ),
            },
        ),
        Import(
            ExtractImport {
                file: "test.tsx",
                order: 1,
                url: "\"a.css\" screen",
            },
        ),
        Import(
            ExtractImport {
                file: "test.tsx",
