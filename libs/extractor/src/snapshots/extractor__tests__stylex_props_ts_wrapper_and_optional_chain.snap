    code: "import \"@devup-ui/react/devup-ui.css\";\nimport stylex from \"@stylexjs/stylex\";\nconst s = {\n\t\"a\": \"OLcolor-vred\",\n\t\"b\": \"OLmargin_dtop-v1px\"\n};\nconst cast = <div {...{ className: \"OLcolor-vred\" }} />;\nconst satisfied = <div {...{ className: \"OLmargin_dtop-v1px\" }} />;\nconst nonNull = <div {...{ className: \"OLcolor-vred\" }} />;\nconst parens = <div {...{ className: \"OLmargin_dtop-v1px\" }} />;\nconst chained = <div {...{ className: \"OLcolor-vred\" }} />;\nconst computedChain = <div {...{ className: s?.[k] || \"\" }} />;\nconst chainedCall = <div {...{ className: [s?.a()].flat(Infinity).filter(Boolean).join(\" \") }} />;\n",
}
