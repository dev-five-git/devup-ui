---
source: libs/extractor/src/lib.rs
expression: "ToBTreeSet::from(extract_tsx(r\"import { Box } from '@devup-ui/react';\nconst e = <Box bg={pick<string>} />;\"))"
---
ToBTreeSet {
    styles: {
        Dynamic(
            ExtractDynamicStyle {
                property: "background",
                level: 0,
                identifier: "pick",
                selector: None,
                style_order: None,
            },
        ),
    },
    code: "import \"@devup-ui/react/devup-ui.css\";\nconst e = <div className=\"a\" style={{ \"--b\": __devupScale(pick) }} />;\nfunction __devupScale(v, s = 4, u = \"px\") {\n\treturn typeof v === \"number\" || typeof v === \"string\" && /^[+-]?(\\d+\\.?\\d*|\\.\\d+)(e[+-]?\\d+)?$/i.test(v) ? v * s + u : v;\n}\n",
}
