                css: ".Ksxt_dtest_ptsx_dcolors{--Ksxv_dtest_ptsx_dtext:purple;--Ksxv_dtest_ptsx_daccent:red;}@media(prefers-color-scheme:dark){.Ksxt_dtest_ptsx_dcolors{--Ksxv_dtest_ptsx_dtext:pink;}}",
                file: "test.tsx",
            },
        ),
        Css(
            ExtractCss {
                css: ":root{--Ksxv_dtest_ptsx_dlayered:white;--Ksxv_dtest_ptsx_dtext:black;--Ksxv_dtest_ptsx_daccent:blue;--Ksxv_dtest_ptsx_dsize:4px;}@media(prefers-color-scheme:dark){:root{--Ksxv_dtest_ptsx_dlayered:teal;--Ksxv_dtest_ptsx_dtext:white;--Ksxv_dtest_ptsx_daccent:lightblue;--Ksxv_dtest_ptsx_donly_x44_ark:gray;}}@supports(color:oklch(0 0 0)){:root{--Ksxv_dtest_ptsx_daccent:oklch(0.6 0.2 250);}}@supports(display:grid){@media(prefers-color-scheme:dark){:root{--Ksxv_dtest_ptsx_dlayered:navy;}}}@supports(color:oklch(0 0 0)){@media(prefers-color-scheme:dark){:root{--Ksxv_dtest_ptsx_daccent:oklch(0.8 0.1 250);}}}",
                file: "test.tsx",
