    code: "import \"@devup-ui/react/devup-ui.css\";\nimport * as stylex from \"@stylexjs/stylex\";\nconst DARK = \"@media (prefers-color-scheme: dark)\";\nconst colors = {\n\t\"layered\": \"var(--Ksxv_dtest_ptsx_dlayered)\",\n\t\"text\": \"var(--Ksxv_dtest_ptsx_dtext)\",\n\t\"accent\": \"var(--Ksxv_dtest_ptsx_daccent)\",\n\t\"onlyDark\": \"var(--Ksxv_dtest_ptsx_donly_x44_ark)\",\n\t\"size\": \"var(--Ksxv_dtest_ptsx_dsize)\"\n};\nconst dracula = \"Ksxt_dtest_ptsx_dcolors\";\nconst styles = { \"box\": \"OHaeya6w57mqyjpw8b OHbs41ycnv6v05ww77\" };\nexport const A = () => <div {...{ className: \"Ksxt_dtest_ptsx_dcolors OHaeya6w57mqyjpw8b OHbs41ycnv6v05ww77\" }} />;\n",
