    code: "import \"@devup-ui/react/devup-ui.css\";\nimport stylex from \"@stylexjs/stylex\";\nconst styles = { \"bar\": \"OHabvk2nrfju4vh2bx OHav8tsjd7fkvybfhy\" };\nconst result = {\n\tclassName: \"OHabvk2nrfju4vh2bx OHav8tsjd7fkvybfhy\",\n\tstyle: {\n\t\t\"---SUHc4xdv0ew6j_mib1s-cb\": ((v) => typeof v === \"number\" ? v + \"px\" : v)(myH),\n\t\t\"---SUHc4xdv0ew6j_mib1s-cp\": ((v) => typeof v === \"number\" ? v + \"px\" : v)(myW)\n\t}\n};\n",
