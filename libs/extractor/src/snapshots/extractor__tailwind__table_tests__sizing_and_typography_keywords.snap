---
source: libs/extractor/src/tailwind_table_tests.rs
expression: "compiled(&[\"max-w-none\", \"max-w-0\", \"max-w-xs\", \"max-w-md\", \"max-w-lg\",\n\"max-w-full\", \"min-h-0\", \"min-h-full\", \"min-h-screen\", \"max-h-none\",\n\"max-h-full\", \"max-h-screen\", \"text-left\", \"text-right\", \"text-justify\",\n\"not-italic\", \"overline\", \"no-underline\", \"lowercase\", \"capitalize\",\n\"normal-case\", \"text-ellipsis\", \"text-clip\", \"text-wrap\", \"text-nowrap\",\n\"text-balance\", \"text-pretty\", \"break-normal\", \"break-words\", \"break-all\",\n\"break-keep\", \"resize-none\", \"resize-y\", \"resize-x\", \"resize\",\n\"outline-(length:--width)\", \"decoration-(length:--width)\", \"shadow-inner\",])"
---
max-w-none => max-width: none
max-w-0 => max-width: 0rem
max-w-xs => max-width: 20rem
max-w-md => max-width: 28rem
max-w-lg => max-width: 32rem
max-w-full => max-width: 100%
min-h-0 => min-height: 0px
min-h-full => min-height: 100%
min-h-screen => min-height: 100vh
max-h-none => max-height: none
max-h-full => max-height: 100%
max-h-screen => max-height: 100vh
text-left => text-align: left
text-right => text-align: right
text-justify => text-align: justify
not-italic => font-style: normal
overline => text-decoration-line: overline
no-underline => text-decoration-line: none
lowercase => text-transform: lowercase
capitalize => text-transform: capitalize
normal-case => text-transform: none
text-ellipsis => text-overflow: ellipsis
text-clip => text-overflow: clip
text-wrap => text-wrap: wrap
text-nowrap => text-wrap: nowrap
text-balance => text-wrap: balance
text-pretty => text-wrap: pretty
break-normal => word-break: normal
break-words => overflow-wrap: break-word
break-all => word-break: break-all
break-keep => word-break: keep-all
resize-none => resize: none
resize-y => resize: vertical
resize-x => resize: horizontal
resize => resize: both
outline-(length:--width) => outline-width: var(--width)
decoration-(length:--width) => text-decoration-thickness: var(--width)
shadow-inner => --tw-shadow: inset 0 2px 4px 0 var(--tw-shadow-color, rgb(0 0 0 / 0.05)); box-shadow: var(--tw-inset-shadow,0 0 #0000), var(--tw-inset-ring-shadow,0 0 #0000), var(--tw-ring-offset-shadow,0 0 #0000), var(--tw-ring-shadow,0 0 #0000), var(--tw-shadow)
