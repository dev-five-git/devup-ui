import { View as Box, Text } from "react-native";
import { useTheme, setTheme as set, getTheme } from "@devup-ui/react/native";
import { type DevupTheme } from "@devup-ui/react";
import { defineThemes as __defineThemes } from "@devup-ui/react/native";
__defineThemes(["default"]);
export function Toggle() {
	const theme = useTheme();
	return <Box onPress={() => set(getTheme() === "dark" ? "light" : "dark")}><Text>{theme}</Text></Box>;
}
